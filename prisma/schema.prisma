// Perfume & Decant POS — Prisma schema
// Dev default: SQLite (zero-config, file-based). For production, swap
// `provider = "sqlite"` -> "postgresql" and set DATABASE_URL accordingly.
// Money/ml fields use Decimal for precision; on Postgres you may add
// native attributes, e.g. `Decimal @db.Decimal(10, 2)`, for stricter typing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum SaleLineType {
  FULL_BOTTLE
  DECANT
  BUNDLE
}

enum InventoryTxType {
  SALE_FULL_BOTTLE
  SALE_DECANT
  BUNDLE_SALE
  RESTOCK
  ADJUSTMENT
  VOID_REVERSAL
  WASTAGE
}

/// Why stock was written off. Drives the wastage report grouping.
enum WastageReason {
  SPILLAGE // spillage / accident
  EVAPORATION
  DAMAGED // damaged or broken bottle
  TESTER // tester / promotional sample
}

/// Where the order came from — set at the till, used for channel analytics.
enum OrderChannel {
  FACEBOOK_MESSENGER
  TELEGRAM
  TIKTOK
  VIBER
  WALK_IN
  OTHER
}

/// Loyalty banding. Recalculated after every sale unless tierLocked is set.
enum CustomerTier {
  NEW
  REGULAR
  VIP
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

/// Operational fulfilment state. Shipping *money* is not tracked here —
/// absorbed postage is recorded as a "Delivery Cost" expense, matching the
/// master Excel model.
enum DeliveryStatus {
  NOT_REQUIRED // walk-in / self pickup
  PENDING // awaiting packing
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String // e.g. "Bleu de Chanel EDP"
  brand       String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@index([brand])
}

/// A "Variant Batch" — one purchased batch of a product, tracked by
/// Variant Batch ID. A batch can sell simultaneously as full bottles
/// (from `unopenedBottles`) and as decants poured from an opened bottle
/// (from `decantActiveRemainingMl`).
model ProductVariant {
  id             String @id @default(cuid())
  variantBatchId String @unique // e.g. "BDC100-B01"

  productId String
  product   Product @relation(fields: [productId], references: [id])

  fullBottleSizeMl Float // e.g. 100
  bottleCost       Decimal // cost of buying ONE full bottle in this batch
  vialCost         Decimal @default(0) // default empty-vial cost per decant poured from this batch
  costPerMl        Decimal // = bottleCost / fullBottleSizeMl — maintained on write, see lib/pricing.ts

  fullBottleSellingPrice Decimal

  // Inventory
  unopenedBottles         Int   @default(0) // integer count of sealed bottles
  decantActiveRemainingMl Float @default(0) // ml remaining in the currently-opened bottle

  batchNumber  String?
  purchaseDate DateTime?
  notes        String?
  isActive     Boolean   @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decantOptions         DecantOption[]
  saleLineItems         SaleLineItem[]
  bundleItems           BundleItem[]
  inventoryTransactions InventoryTransaction[]
  wastageLogs           WastageLog[]

  @@index([productId])
  @@index([supplierId])
}

// ─────────────────────────────────────────────
// Suppliers
// ─────────────────────────────────────────────

model Supplier {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  /// Social media handle or contact URL (Facebook, Telegram, Viber…).
  contactLink String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  // Not unique — duplicates are surfaced as a warning the admin can override,
  // since two real suppliers can share a name and phones are often missing.
  @@index([name])
  @@index([phone])
}

// ─────────────────────────────────────────────
// Customers (CRM)
// ─────────────────────────────────────────────

model Customer {
  id      String  @id @default(cuid())
  name    String?
  /// Unique when present — the key used to match repeat buyers at the till.
  phone   String? @unique
  address String?

  /// How this customer first reached the shop.
  channel OrderChannel @default(WALK_IN)

  tier CustomerTier @default(NEW)
  /// When true, the automatic tier calculation leaves this customer alone.
  tierLocked Boolean @default(false)

  /// Fragrance preferences, notes on likes/dislikes.
  preferences String?
  notes       String?

  // Denormalised aggregates, recomputed on each sale and on void.
  totalOrders    Int       @default(0)
  totalSpent     Decimal   @default(0)
  lastPurchaseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([name])
  @@index([tier])
  @@index([channel])
}

/// A sellable decant size + price for a given batch, e.g. 5ml / 10ml / 15ml.
model DecantOption {
  id String @id @default(cuid())

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  sizeMl       Float
  sellingPrice Decimal
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, sizeMl])
}

// ─────────────────────────────────────────────
// Bundles (custom sets)
// ─────────────────────────────────────────────

model Bundle {
  id          String @id @default(cuid())
  name        String // e.g. "3x10ml Discovery Set"
  sku         String @unique
  description String?

  sellingPrice Decimal
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         BundleItem[]
  saleLineItems SaleLineItem[]
}

/// A constituent line inside a bundle: N units of a specific full bottle
/// or decant size, drawn from a specific ProductVariant's live inventory.
model BundleItem {
  id String @id @default(cuid())

  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  itemType     SaleLineType // FULL_BOTTLE | DECANT (BUNDLE not valid here)
  decantSizeMl Float? // required when itemType = DECANT
  quantity     Int // units of this constituent per ONE bundle sold

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productVariantId])
}

// ─────────────────────────────────────────────
// Sales
// ─────────────────────────────────────────────

model Sale {
  id            String     @id @default(cuid())
  saleNumber    String     @unique
  saleDate      DateTime   @default(now())
  /// Denormalised snapshot — kept even if the CRM record is later edited.
  customerName  String?
  customerPhone String?
  paymentMethod String     @default("CASH")

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Originating channel for this specific order.
  orderChannel OrderChannel @default(WALK_IN)

  subtotal    Decimal
  discount    Decimal @default(0)
  tax         Decimal @default(0)
  total       Decimal
  totalCost   Decimal
  totalProfit Decimal

  status SaleStatus @default(COMPLETED)
  notes  String?

  // Fulfilment tracking
  deliveryStatus  DeliveryStatus @default(NOT_REQUIRED)
  courier         String?
  trackingNumber  String?
  deliveryAddress String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  createdAt DateTime @default(now())

  lineItems SaleLineItem[]

  @@index([saleDate])
  @@index([status])
  @@index([deliveryStatus])
  @@index([customerName])
  @@index([customerId])
  @@index([orderChannel])
  @@index([paymentMethod])
}

model SaleLineItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  lineType SaleLineType

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  decantSizeMl     Float? // set when lineType = DECANT

  bundleId String?
  bundle   Bundle? @relation(fields: [bundleId], references: [id])

  quantity   Int
  unitCost   Decimal // cost snapshot at time of sale
  unitPrice  Decimal // price snapshot at time of sale
  lineCost   Decimal
  lineTotal  Decimal
  lineProfit Decimal

  createdAt DateTime @default(now())

  @@index([saleId])
}

/// Audit trail for every inventory movement (sale, restock, manual adjustment).
model InventoryTransaction {
  id String @id @default(cuid())

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  type          InventoryTxType
  bottlesDelta  Int   @default(0) // negative = deduction
  mlDelta       Float @default(0) // negative = deduction

  saleId    String?
  reference String? // e.g. bundle name / manual note

  createdAt DateTime @default(now())

  @@index([productVariantId])
  @@index([saleId])
}

// ─────────────────────────────────────────────
// Expenses
// ─────────────────────────────────────────────

model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  /// Example line items, shown as a hint in the expense form.
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  expenses Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  description String?
  amount      Decimal
  expenseDate DateTime        @default(now())

  /// Set when the row was generated by the system (e.g. wastage write-off)
  /// rather than typed by hand. Auto rows are read-only in the ledger UI.
  isAutomatic Boolean @default(false)

  createdAt DateTime @default(now())

  wastageLog WastageLog?

  @@index([expenseDate])
}

// ─────────────────────────────────────────────
// Wastage / stock loss
// ─────────────────────────────────────────────

/// A stock write-off with its monetary value, mirrored into the expense
/// ledger so net profit absorbs the loss.
model WastageLog {
  id String @id @default(cuid())

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  reason WastageReason

  bottlesDeducted Int   @default(0)
  mlDeducted      Float @default(0)

  /// Cost basis snapshot at the moment of the write-off.
  costPerMl  Decimal
  bottleCost Decimal
  /// (ml x costPerMl) + (bottles x bottleCost)
  lossValue  Decimal

  note String?

  /// The auto-generated expense row, if one was created. Cleared on void.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  /// Set when the write-off was reverted; stock and the expense are undone
  /// but the row is kept so the correction stays auditable.
  voidedAt DateTime?

  createdAt DateTime @default(now())

  @@index([productVariantId])
  @@index([createdAt])
  @@index([reason])
}

// ─────────────────────────────────────────────
// Settings
// ─────────────────────────────────────────────

/// Simple key/value store for tunable thresholds (low stock, tier cutoffs).
/// Values are stored as strings and parsed in lib/settings.ts.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}
